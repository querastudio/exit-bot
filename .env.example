# ── Wallet (use a dedicated wallet, separate from any other bot) ──────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC (your own endpoint) ─────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── Fallback RPC (optional — retried on network-level failures of RPC_URL) ────
RPC_URL_FALLBACK=

# ── Jito Block Engine (optional — only used if jitoEnabled in user-config.json) ─
# Default (unset) is the global NY endpoint. Try a region closer to where
# your bot is deployed if bundles aren't landing well:
#   https://mainnet.block-engine.jito.wtf/api/v1      (default, NY/global)
#   https://amsterdam.mainnet.block-engine.jito.wtf/api/v1
#   https://frankfurt.mainnet.block-engine.jito.wtf/api/v1
#   https://tokyo.mainnet.block-engine.jito.wtf/api/v1
#   https://slc.mainnet.block-engine.jito.wtf/api/v1
JITO_BLOCK_ENGINE_URL=

# ── Telegram notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Jupiter (optional — only needed for higher rate limits) ───────────────────
JUPITER_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
